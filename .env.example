# Threads API access token (long-lived user token for the Threads account to watch)
THREADS_ACCESS_TOKEN=

# Your own Threads username, used to tell "already answered by me" replies
# apart from everyone else's (so data/topics.md can show only what's still
# unanswered).
THREADS_USERNAME=

# Google AI Studio API key (free tier Gemini Flash, used for photo descriptions)
GEMINI_API_KEY=

# Gemini model to use for vision descriptions.
# Note: the "-latest" aliases (e.g. gemini-flash-latest) returned 503s when
# this was last verified; gemini-3.8-flash was confirmed working directly.
# Re-check https://ai.google.dev/gemini-api/docs/models if this starts 404ing.
GEMINI_MODEL=gemini-3.5-flash-lite

# How many days back to scan root posts. The window applies to the root
# post's own age, not its replies -- so a reply arriving on day 3 is still
# picked up as long as its root post was created within this window. 4 is
# a deliberate buffer over "today + yesterday" (2) so slower trickle-in
# conversations (e.g. interview-style replies answered a day or two late)
# don't age out before they're ever marked answered.
LOOKBACK_DAYS=4
