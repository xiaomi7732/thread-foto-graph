# Threads API access token (long-lived user token for the Threads account to watch)
THREADS_ACCESS_TOKEN=

# Google AI Studio API key (free tier Gemini Flash, used for photo descriptions)
GEMINI_API_KEY=

# Gemini model to use for vision descriptions.
# Note: the "-latest" aliases (e.g. gemini-flash-latest) returned 503s when
# this was last verified; gemini-3.8-flash was confirmed working directly.
# Re-check https://ai.google.dev/gemini-api/docs/models if this starts 404ing.
GEMINI_MODEL=gemini-3.8-flash

# How many days back to scan (today + yesterday = 2)
LOOKBACK_DAYS=2
