# Threads API access token (long-lived user token for the Threads account to watch)
THREADS_ACCESS_TOKEN=

# Your own Threads username, used to tell "already answered by me" replies
# apart from everyone else's (so data/topics.md can show only what's still
# unanswered).
THREADS_USERNAME=

# Vision mode: gemini (backward-compatible default), ollama (local only),
# or auto (Ollama first; Gemini fallback only when GEMINI_API_KEY is set).
VISION_PROVIDER=gemini

OLLAMA_BASE_URL=http://127.0.0.1:11434
# Use the explicit instruct tag; the bare 4b alias can select a thinking model.
OLLAMA_MODEL=qwen3-vl:4b-instruct
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_READ_TIMEOUT_SECONDS=180

# Separate attempt budgets; local requests never consume the Gemini budget.
MAX_VISION_REQUESTS_PER_RUN=1400
MAX_LOCAL_VISION_REQUESTS_PER_RUN=200
# Stops new vision work/retries; Linux wrapper also has a 3000s hard backstop.
VISION_RUN_TIMEOUT_SECONDS=2700

# Google AI Studio API key (required for gemini, optional fallback for auto)
GEMINI_API_KEY=

# Gemini model to use for vision descriptions.
# Note: the "-latest" aliases (e.g. gemini-flash-latest) returned 503s when
# this was last verified; gemini-3.8-flash was confirmed working directly.
# Re-check https://ai.google.dev/gemini-api/docs/models if this starts 404ing.
GEMINI_MODEL=gemini-3.5-flash-lite

# How many days back to scan root posts. The window applies to the root
# post's own age, not its replies -- so a reply arriving on day 3 is still
# picked up as long as its root post was created within this window. 4 is
# a deliberate buffer over "today + yesterday" (2) so slower trickle-in
# conversations (e.g. interview-style replies answered a day or two late)
# don't age out before they're ever marked answered.
LOOKBACK_DAYS=4

# Optional absolute floor on what's ever scanned, as an ISO 8601 date/
# datetime (e.g. 2026-01-01 or 2026-01-01T00:00:00Z). Root posts older than
# this are skipped outright, regardless of LOOKBACK_DAYS -- useful to
# permanently exclude old posts without having to keep LOOKBACK_DAYS small
# forever. Leave blank for no floor (the default).
HARD_CUTOFF_DATE=

# Re-fetch the conversation after describing new photos, up to this many times.
MAX_ITERATIONS=3

# Independent API-only outward pilot: age of OUR comments, not root posts.
OUTWARD_LOOKBACK_DAYS=14

# Pilot cap, newest first; applies to registry entries when the registry exists.
OUTWARD_MAX_REPLIES=40
